# === LLM Configuration ===
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1    # OpenRouter, or leave empty for direct OpenAI

# === Embedding Configuration ===
EMBEDDING_API_KEY=your_api_key_here           # Can be same as LLM_API_KEY for OpenRouter
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1

# === Database ===
# Default connects to Docker Compose PostgreSQL
# DSN=postgresql://nemori:nemori@localhost:5432/nemori

# === Qdrant ===
# Default connects to Docker Compose Qdrant at localhost:6333
# QDRANT_URL=localhost
# QDRANT_PORT=6333

# === Phoenix LLM Tracing (optional; install with `uv sync --extra tracing`) ===
# NEMORI_ENABLE_LLM_TRACING=true
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_PROJECT_NAME=nemori
# Trace payloads are redacted by default. Set any value to false only when the
# collector is trusted and raw debugging data is explicitly required.
# OPENINFERENCE_HIDE_INPUTS=true
# OPENINFERENCE_HIDE_OUTPUTS=true
# OPENINFERENCE_HIDE_EMBEDDINGS_VECTORS=true
# OPENINFERENCE_HIDE_EMBEDDINGS_TEXT=true
